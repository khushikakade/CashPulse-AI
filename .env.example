# CashPulse AI environment configuration template

# Environment
ENVIRONMENT=development
PROJECT_NAME="CashPulse AI"

# Database & Cache (FastAPI uses SQLite fallback automatically if DATABASE_URL is missing)
DATABASE_URL=sqlite:///./cashpulse.db
# REDIS_URL=redis://localhost:6379/0

# Razorpay credentials (get these from your Razorpay Dashboard in Test/Live Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Cashfree credentials (get these from Cashfree Merchant Dashboard)
CASHFREE_APP_ID=cf_test_placeholder_app_id
CASHFREE_SECRET_KEY=cf_test_placeholder_secret_key
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENV=SANDBOX

# LLM Providers (Options: mock, gemini, openai)
LLM_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
